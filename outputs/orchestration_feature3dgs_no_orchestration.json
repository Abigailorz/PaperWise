                    "path": "C:\\Users\\13970\\Documents\\Codex\\2026-08-18\\https-github-com-abigailorz-paperwise-git\\work\\PaperWise\\workspace\\benchmarks\\eval_workspace\\eval_runs\\report_generation_1787746207_0\\paper\\text.md"
                  }
                },
