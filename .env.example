  # PaperWise Configuration
  # Copy this file to .env and fill in your API keys
  # cp .env.example .env
  # SECURITY: .env is in .gitignore. Never commit API keys.

  # === LLM Provider ===
  # Supported: deepseek, moonshot, openai, openai_compatible
  PAPERWISE_LLM_PROVIDER=deepseek
  PAPERWISE_DEFAULT_MODEL=deepseek-v4-flash

  # === Judge (异源评估) ===
  # 评估/幻觉检测用的独立模型，建议与主模型不同源，避免「同源包庇」。
  # 当前配置：主模型用 deepseek-chat（Agent），Judge 用 kimi-k3（Moonshot）。
  # Agent 需填入 DEEPSEEK_API_KEY；Judge 已使用 Kimi K3（与 Agent 不同源）。
  # judge_api_key / judge_base_url 留空时会自动回退到对应 provider 的主配置。
  PAPERWISE_JUDGE_PROVIDER=moonshot
  PAPERWISE_JUDGE_MODEL=kimi-k3
  PAPERWISE_JUDGE_API_KEY=
  PAPERWISE_JUDGE_BASE_URL=

  # === DeepSeek API ===
  # Get your API key from: https://platform.deepseek.com/api_keys
  DEEPSEEK_API_KEY=sk-your-deepseek-api-key
  DEEPSEEK_BASE_URL=https://api.deepseek.com

  # === Kimi K3 (Moonshot) API ===
  # Get your API key from: https://platform.moonshot.cn/console/api-keys
  MOONSHOT_API_KEY=sk-your-moonshot-api-key
  MOONSHOT_BASE_URL=https://api.moonshot.cn/v1

  # === OpenAI API (optional) ===
  OPENAI_API_KEY=
  OPENAI_BASE_URL=https://api.openai.com/v1

  # === Embeddings API (optional) ===
  PAPERWISE_EMBEDDING_API_KEY=
  PAPERWISE_EMBEDDING_BASE_URL=https://api.openai.com/v1
  PAPERWISE_EMBEDDING_MODEL=text-embedding-3-small

  # === Workspace ===
  PAPERWISE_WORKSPACE=./workspace

  # === Agent Settings ===
  PAPERWISE_MAX_STEPS=25
  PAPERWISE_TOKEN_BUDGET=180000
  PAPERWISE_TEMPERATURE=0.3

  # === Safety ===
  # Set to 1 to bypass the heterogeneous-judge warning (not recommended).
  # PAPERWISE_ALLOW_HOMOGENEOUS_JUDGE=0
